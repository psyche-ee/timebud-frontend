# TimeBud frontend — Vite env variables are exposed to the browser.
# Prefix every variable with VITE_ so Vite inlines it at build time.

# Leave VITE_API_BASE_URL unset so the client derives the backend from the
# current hostname (localhost locally, 10.0.49.82 on LAN/mobile). For a
# deployed frontend, set it explicitly to the deployed API URL.
VITE_GOOGLE_CLIENT_ID=989184819859-p010gku7pfjdhg1dmo4r7r3tjbp37005.apps.googleusercontent.com
